# Copy to .env and fill in. The API refuses to start if any of these are
# missing or malformed — see src/config/env.ts.

NODE_ENV=development
PORT=3000

# --- database (required; the API will not boot without a reachable DB) -------
DATABASE_URL=postgresql://tankertrack_app:CHANGE_ME@127.0.0.1:5432/tankertrack
DATABASE_POOL_MAX=10
# Set to 'require' against managed Postgres. TLS is mandatory outside development.
DATABASE_SSL=disable

# --- auth --------------------------------------------------------------------
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=CHANGE_ME
JWT_REFRESH_SECRET=CHANGE_ME_TOO
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# --- object storage for bill scans and stop photos ---------------------------
S3_ENDPOINT=http://127.0.0.1:9000
S3_REGION=ap-south-1
S3_BUCKET=tankertrack-bills
S3_ACCESS_KEY_ID=CHANGE_ME
S3_SECRET_ACCESS_KEY=CHANGE_ME
S3_FORCE_PATH_STYLE=true

# --- limits ------------------------------------------------------------------
MAX_BILL_UPLOAD_BYTES=10485760
RATE_LIMIT_TTL_SECONDS=60
RATE_LIMIT_MAX=120
